<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBgBrush" Color="#eef2f7" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#64748b" />
    <SolidColorBrush x:Key="InkBrush" Color="#0f172a" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563eb" />
    <SolidColorBrush x:Key="CardBrush" Color="#ffffff" />
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#1e3a5f" />
        <GradientStop Offset="1" Color="#0f2744" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupHeaderGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#1e40af" />
        <GradientStop Offset="1" Color="#0f2744" />
    </LinearGradientBrush>
</ResourceDictionary>
